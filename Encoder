8:3 encoder

        Design

module encoder(a,b,c,y0,y1,y2,y3,y4,y5,y6,y7);
output a,b,c;
input y0,y1,y2,y3,y4,y5,y6,y7;
//gate-level-modeling
or t1(a,y4,y5,y6,y7);
or t2(b,y2,y3,y6,y7);
or t3(c,y1,y3,y5,y7);
endmodule

    Data-Flow-Modeling
 
module encoder(a,b,c,y0,y1,y2,y3,y4,y5,y6,y7);
output a,b,c;
input y0,y1,y2,y3,y4,y5,y6,y7;
//data flow modeling
assign a=y4|y5|y6|y7;
assign b=y2|y3|y6|y7;
assign c=y1|y3|y5|y7;
endmodule

