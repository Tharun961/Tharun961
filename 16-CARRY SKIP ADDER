16-CARRY SKIP ADDER
                            
                      DESIGN

module fa(s, c, cin, a, b);
  output s, c;
  input a, b, cin;
  wire w1, w2, w3;

  xor (w1, a, b);
  xor (s, w1, cin);
  and (w2, w1, cin);
  and (w3, a, b);
  or (c, w2, w3);
endmodule

module csa_16bit(s, cout, a, b, cin);
  output [15:0] s;
  output cout;
  input [15:0] a, b;
  input cin;
  wire [15:0] p;
  wire carry, prop;

  fa fa0(s[0], p[0], cin, a[0], b[0]);
  fa fa1(s[1], p[1], p[0], a[1], b[1]);
  fa fa2(s[2], p[2], p[1], a[2], b[2]);
  fa fa3(s[3], p[3], p[2], a[3], b[3]);
  fa fa4(s[4], p[4], p[3], a[4], b[4]);
  fa fa5(s[5], p[5], p[4], a[5], b[5]);
  fa fa6(s[6], p[6], p[5], a[6], b[6]);
  fa fa7(s[7], p[7], p[6], a[7], b[7]);
  fa fa8(s[8], p[8], p[8], a[8], b[8]);
  fa fa9(s[9], p[9], p[9], a[9], b[9]);
  fa fa10(s[10], p[10], p[10], a[10], b[10]);
  fa fa11(s[11], p[11], p[11], a[11], b[11]);
  fa fa12(s[12], p[12], p[12], a[12], b[12]);
  fa fa13(s[13], p[13], p[13], a[13], b[13]);
  fa fa14(s[14], p[14], p[14], a[14], b[14]);
  fa fa15(s[15], p[15], p[15], a[15], b[15]);


  and (prop, a[0]^b[0], a[1]^b[1], a[2]^b[2], a[3]^b[3], a[4]^b[4], a[5]^b[5], a[6]^b[6], a[7]^b[7], a[8]^b[8], a[9]^b[9], a[10]^b[10], a[11]^b[11], a[12]^b[12], a[13]^b[13], a[14]^b[14], a[15]^b[15]);
  mux m1(cout, p[7], cin, prop);
endmodule

module mux(c, carry, cin, prop);
  output c;
  input carry, cin, prop;

  assign c = (prop) ? cin : carry;
endmodule

