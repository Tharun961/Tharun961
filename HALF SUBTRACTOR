HALF SUBTRACTOR
           DESIGN
     GATE LEVEL MODELING
module ha_sub(d,bo,a,b);
output d,bo;
input a,b;
wire w1;
//gate level modeling 
xor t1(d,a,b);
not t2(w1,a);
and t3(bo,w1,b);
endmodule

DATA FLOW MODELING
module ha_sub(d,bo,a,b);
output d,bo;
input a,b;
wire w1;
//data flow modeling
assign  d=(a^b);
assign w1=~a;
assign bo=(w1 & b);
endmodule

BEHAVIROL-MODELING
module ha_sub(d, bo, a, b);
  output reg d, bo;
  input a, b;
  
  always @(a or b) begin
    if (a == 0 && b == 0) begin 
      d = 0;
      bo = 0;
    end
    else if (a == 0 && b == 1) begin 
      d = 1;
      bo = 1;
    end
    else if (a == 1 && b == 0) begin 
      d = 1;
      bo = 0;
    end
    else if (a == 1 && b == 1) begin 
      d = 0;
      bo = 0;
    end
  end
endmodule
          
