1.HALF ADDER
                  GATE-LEVEL-MODELING
                         DESIGN
module ha(s,c,a,b);
output s,c;
input a,b;
//gate level modeling
xor t1(s,a,b);
and t2(c,a,b);
endmodule
                  DATA-FLOW-MODELING

module ha(s,c,a,b);
output s,c;
input a,b;
//data flow modeling
assign s=(a^b);
assign c=(a&b);
endmodule

                 BEHAVIROL-MODELING
module ha(s,c,a,b);
output reg s,c;
input a,b;
//behavirol modeling
always @(a or b)
begin 
if(a==0 && b==0)
begin s=0; c=0;
end
if(a==0 && b==1)
begin s=1; c=0;
end
if (a==1 &&  b==0)
begin s=1; c=0;
end
if (a==1 && b==1)
begin s=0; c=1;
end
end
endmodule
