1.NOT GATE
                  GATE-LEVEL-MODELING
                       DESIGN
module notg(y,a);
output y;
input a;
not t1(y,a);
endmodule
                   DATA-FLOW-MODELING
module notg(y,a);
output y;
input a;
assign  y= ~a;
endmodule
                  BEHAVIROL-MODELING
module notg(y,a);
output reg y;
input a;
always @(a)
begin
if (a==0)
begin y=1;
end
if (a==1)
begin y=0;
end 
end
endmodule
                    TESTBENCH

module notg_tb();
wire y;
reg a;
notg uut(y,a);
initial begin
a=0;
#100 a=1;
end
endmodule

