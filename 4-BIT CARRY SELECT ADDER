module csa_tb();
  reg [3:0] a, b;  
  reg [1:0] cin;   
  wire [3:0] s;    
  wire cout;     
  csa uut (s, cout, a, b, cin);
  initial begin
  a = 4'b0101; b = 4'b0011; cin = 2'b01;
  end
endmodule
