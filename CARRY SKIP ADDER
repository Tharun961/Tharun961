                                DESIGN
module fa(s, c, cin, a, b);
  output s, c;
  input a, b, cin;
  wire w1, w2, w3;
  xor (w1, a, b);
  xor (s, w1, cin);
  and (w2, w1, cin);
  and (w3, a, b);
  or (c, w2, w3);
endmodule

module csa(s, cout, a, b, cin);
  output [3:0] s;
  output cout;
  input [3:0] a, b;
  input cin;
  wire [3:0] p;
  wire carry, prop;
  fa fa0(s[0], p[0], cin, a[0], b[0]);
  fa fa1(s[1], p[1], p[0], a[1], b[1]);
  fa fa2(s[2], p[2], p[1], a[2], b[2]);
  fa fa3(s[3], p[3], p[2], a[3], b[3]);
  and (prop, a[0]^b[0], a[1]^b[1], a[2]^b[2], a[3]^b[3]);
  mux m1(cout, p[3], cin, prop);
endmodule
module mux(c, carry, cin, prop);
  output c;
  input carry, cin, prop;
  assign c = (prop) ? cin : carry;
endmodule
