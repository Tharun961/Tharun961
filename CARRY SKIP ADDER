`timescale 1ns/1ps

module csa_tb;
  reg [3:0] a, b;
  reg cin;
  wire [3:0] s;
  wire cout;

csa uut(s, cout, a, b, cin);
 initial begin
    a = 4'b1111; b = 4'b1111; cin = 0; #10;
  end
endmodule
